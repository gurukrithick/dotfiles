{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // colours are kitty palette slots (kitty/kitty.conf): 119 accent, 137-142 shades
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;119", "title": "38;5;119", "separator": "default" }
  },
  "modules": [
    { "type": "title", "color": { "user": "38;5;119", "at": "white", "host": "default" } },
    "break",
    { "type": "os",       "key": "" },
    { "type": "kernel",   "key": "" },
    { "type": "uptime",   "key": "" },
    { "type": "packages", "key": "" },
    { "type": "wm",       "key": "" },
    { "type": "shell",    "key": "" },
    { "type": "memory",   "key": "" },
    "break",
    // shade bar
    { "type": "custom", "format": "{#48;5;137}    {#48;5;138}    {#48;5;139}    {#48;5;140}    {#48;5;141}    {#48;5;142}    {#}" }
  ]
}
